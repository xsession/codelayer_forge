{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.codelayer.hu/forge/plugin-manifest/v1",
  "title": "CodeLayer Forge Plugin Manifest",
  "type": "object",
  "required": [
    "manifest_version",
    "id",
    "name",
    "version",
    "publisher",
    "description",
    "runtime",
    "platform_api"
  ],
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(?:\\.[a-z0-9-]+){2,}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "runtime": {
      "enum": [
        "python",
        "native",
        "wasm",
        "webview"
      ]
    },
    "entrypoint": {
      "type": [
        "string",
        "null"
      ]
    },
    "platform_api": {
      "type": "string"
    },
    "activation_events": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provides": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
