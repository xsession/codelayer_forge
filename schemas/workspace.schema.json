{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.codelayer.hu/forge/workspace/v1",
  "title": "CodeLayer Forge Workspace",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "enabled_plugins"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "enabled_plugins": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "settings": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
